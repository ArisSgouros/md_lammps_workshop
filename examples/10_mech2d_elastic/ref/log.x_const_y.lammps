# ============================================================
# 2. NPT equilibration in x and y
# ============================================================

print           "Starting NPT equilibration in x and y"
Starting NPT equilibration in x and y

fix             FNPXY all npt temp ${temp} ${temp} ${tdamp}                              x ${press_x} ${press_x} ${pdamp}                                        y ${press_y} ${press_y} ${pdamp}
fix             FNPXY all npt temp 5 ${temp} ${tdamp}                              x ${press_x} ${press_x} ${pdamp}                                        y ${press_y} ${press_y} ${pdamp}
fix             FNPXY all npt temp 5 5 ${tdamp}                              x ${press_x} ${press_x} ${pdamp}                                        y ${press_y} ${press_y} ${pdamp}
fix             FNPXY all npt temp 5 5 0.1                              x ${press_x} ${press_x} ${pdamp}                                        y ${press_y} ${press_y} ${pdamp}
fix             FNPXY all npt temp 5 5 0.1                              x 0 ${press_x} ${pdamp}                                        y ${press_y} ${press_y} ${pdamp}
fix             FNPXY all npt temp 5 5 0.1                              x 0 0 ${pdamp}                                        y ${press_y} ${press_y} ${pdamp}
fix             FNPXY all npt temp 5 5 0.1                              x 0 0 1                                        y ${press_y} ${press_y} ${pdamp}
fix             FNPXY all npt temp 5 5 0.1                              x 0 0 1                                        y 0 ${press_y} ${pdamp}
fix             FNPXY all npt temp 5 5 0.1                              x 0 0 1                                        y 0 0 ${pdamp}
fix             FNPXY all npt temp 5 5 0.1                              x 0 0 1                                        y 0 0 1


run             ${nnpt}
run             20000
