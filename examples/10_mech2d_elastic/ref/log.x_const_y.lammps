Ave special neighs/atom = 18
Neighbor list builds = 1
Dangerous builds = 0

unfix           FNPXY

# ============================================================
# 3. Reference box calculation
# ============================================================
# A further NPT run is performed.
# The reference lx and ly are calculated as time averages over
# nave timesteps.

print           "Starting reference-box averaging run"
Starting reference-box averaging run

undump          DALL
reset_timestep  0

dump            DALL all custom ${dump_every} ${fdump_ref} id type xu yu
dump            DALL all custom 1000 ${fdump_ref} id type xu yu
dump            DALL all custom 1000 o.dump.ref.lammpstrj id type xu yu
dump_modify     DALL sort id

variable        lx_inst equal lx
variable        ly_inst equal ly

fix             FREFNPT all npt temp ${temp} ${temp} ${tdamp}                            x ${press_x} ${press_x} ${pdamp}                                        y ${press_y} ${press_y} ${pdamp}
fix             FREFNPT all npt temp 5 ${temp} ${tdamp}                            x ${press_x} ${press_x} ${pdamp}                                        y ${press_y} ${press_y} ${pdamp}
fix             FREFNPT all npt temp 5 5 ${tdamp}                            x ${press_x} ${press_x} ${pdamp}                                        y ${press_y} ${press_y} ${pdamp}
fix             FREFNPT all npt temp 5 5 0.1                            x ${press_x} ${press_x} ${pdamp}                                        y ${press_y} ${press_y} ${pdamp}
fix             FREFNPT all npt temp 5 5 0.1                            x 0 ${press_x} ${pdamp}                                        y ${press_y} ${press_y} ${pdamp}
fix             FREFNPT all npt temp 5 5 0.1                            x 0 0 ${pdamp}                                        y ${press_y} ${press_y} ${pdamp}
fix             FREFNPT all npt temp 5 5 0.1                            x 0 0 1                                        y ${press_y} ${press_y} ${pdamp}
fix             FREFNPT all npt temp 5 5 0.1                            x 0 0 1                                        y 0 ${press_y} ${pdamp}
fix             FREFNPT all npt temp 5 5 0.1                            x 0 0 1                                        y 0 0 ${pdamp}
fix             FREFNPT all npt temp 5 5 0.1                            x 0 0 1                                        y 0 0 1

fix             FREFAVG all ave/time 1 ${nave} ${nave}                      v_lx_inst v_ly_inst ave one
fix             FREFAVG all ave/time 1 20000 ${nave}                      v_lx_inst v_ly_inst ave one
fix             FREFAVG all ave/time 1 20000 20000                      v_lx_inst v_ly_inst ave one


run             ${nave}
