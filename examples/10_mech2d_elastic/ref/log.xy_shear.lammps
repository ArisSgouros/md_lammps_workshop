# ============================================================
# 5. Selected deformation scheme
# ============================================================

include         deform.${deform_tag}.lmp
include         deform.xy_shear.lmp
# ============================================================
# 5. Constant-rate xy shear deformation
# ============================================================
# The xy tilt factor is deformed at a constant engineering shear rate.
# lx and ly are kept fixed; no barostat is used during deformation.
#
# The shear strain variable is reported as gamma_xy = xy / ly_ref.
# This assumes that the imposed reference box is initially orthogonal.
# ============================================================

print           "Starting xy shear deformation with fixed lx and ly"
Starting xy shear deformation with fixed lx and ly

undump          DALL
reset_timestep  0

# Shear deformation requires a triclinic box.
# The reference box is orthogonal, so it is converted before applying shear.
change_box      all triclinic
Changing box ...
  triclinic box = (-0.30721873 -0.26605321 -0.5) to (75.131814 65.066053 0.5) with tilt (0 0 0)

