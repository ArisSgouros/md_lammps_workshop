variable        eyy equal "(ly - v_ly_ref)/v_ly_ref"
variable        exy equal "xy/v_ly_ref"

thermo_style    custom step v_exx v_eyy v_exy temp etotal ebond eangle edihed                     pxx pyy pxy lx ly xy
