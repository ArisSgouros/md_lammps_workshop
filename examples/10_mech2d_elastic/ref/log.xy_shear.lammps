  read_data CPU = 0.052 seconds

include         potential.mod
pair_style zero 10
pair_coeff * *
bond_style morse
bond_coeff 1 5.35 1.897 1.4518
angle_style quartic
angle_coeff 1 120 2.685 -1.78 0
angle_coeff 2 120 2.685 -1.78 0
dihedral_style harmonic
dihedral_coeff 1 0.109 -1 2
dihedral_coeff 2 0.066 -1 2

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        ${dt}
timestep        0.001

fix             F2D all enforce2d

thermo          ${thermo_every}
thermo          500
thermo_style    custom step temp etotal ebond eangle edihed pxx pyy lx ly
thermo_modify   flush yes

dump            DALL all custom ${dump_every} ${fdump_equil} id type xu yu
dump            DALL all custom 1000 ${fdump_equil} id type xu yu
dump            DALL all custom 1000 o.dump.eq.lammpstrj id type xu yu
dump_modify     DALL sort id

# -------------------------
# Energy minimization
# -------------------------

print           "Starting energy minimization"
Starting energy minimization

min_style       cg
minimize        0.0 1.0e-9 ${nmin} ${nmin}
minimize        0.0 1.0e-9 100000 ${nmin}
minimize        0.0 1.0e-9 100000 100000
