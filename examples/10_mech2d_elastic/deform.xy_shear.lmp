# ============================================================
# 5. Constant-rate xy shear deformation
# ============================================================
# The xy tilt factor is deformed at a constant engineering shear rate.
# lx and ly are kept fixed; no barostat is used during deformation.
#
# The shear strain variable is reported as gamma_xy = xy / ly_ref.
# This assumes that the imposed reference box is initially orthogonal.
# ============================================================

print           "Starting xy shear deformation with fixed lx and ly"

undump          DALL
reset_timestep  0

# Shear deformation requires a triclinic box.
# The reference box is orthogonal, so it is converted before applying shear.
change_box      all triclinic

dump            DALL all custom ${dump_every} ${fdump_def} id type xu yu
dump_modify     DALL sort id

variable        exx equal "(lx - v_lx_ref)/v_lx_ref"
variable        eyy equal "(ly - v_ly_ref)/v_ly_ref"
variable        exy equal "xy/v_ly_ref"

thermo_style    custom step v_exx v_eyy v_exy temp etotal ebond eangle edihed     &
                pxx pyy pxy lx ly xy
thermo_modify   flush yes

fix             FDEF all deform 1 xy erate ${erate} units box remap x

fix             FNVT all nvt temp ${temp} ${temp} ${tdamp}

run             ${ndeform}

unfix           F2D
unfix           FNVT
unfix           FDEF

undump          DALL

print           "Done."
