# -------------------------
# Store reference dimensions
# -------------------------
# Immediate variables are used here so that the averaged values are
# frozen before FREFAVG is removed.

variable        lx_ref equal $(f_FREFAVG[1])
variable        lx_ref equal 75.437998896180559427
variable        ly_ref equal $(f_FREFAVG[2])
variable        ly_ref equal 65.331220155781110748

variable        xmid_ref equal $(0.5*(xlo+xhi))
variable        xmid_ref equal 37.412297444999083496
variable        ymid_ref equal $(0.5*(ylo+yhi))
variable        ymid_ref equal 32.400000000000417799

variable        xlo_ref equal $(v_xmid_ref - 0.5*v_lx_ref)
variable        xlo_ref equal -0.30670200309120332349
variable        xhi_ref equal $(v_xmid_ref + 0.5*v_lx_ref)
variable        xhi_ref equal 75.131296893089398736

variable        ylo_ref equal $(v_ymid_ref - 0.5*v_ly_ref)
variable        ylo_ref equal -0.2656100778901517856
variable        yhi_ref equal $(v_ymid_ref + 0.5*v_ly_ref)
variable        yhi_ref equal 65.065610077890937646

print           "Reference box:"
Reference box:
print           "  lx_ref  = ${lx_ref}"
  lx_ref  = 75.4379988961806
print           "  ly_ref  = ${ly_ref}"
  ly_ref  = 65.3312201557811
print           "  xlo_ref = ${xlo_ref}"
  xlo_ref = -0.306702003091203
print           "  xhi_ref = ${xhi_ref}"
  xhi_ref = 75.1312968930894
print           "  ylo_ref = ${ylo_ref}"
  ylo_ref = -0.265610077890152
print           "  yhi_ref = ${yhi_ref}"
  yhi_ref = 65.0656100778909

unfix           FREFAVG
unfix           FREFNPT

